<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" />
    <field id="index" type="integer" />
    <field id="rowIndex" type="integer" />
    <field id="rowHasFocus" type="boolean" />
    <field id="itemHasFocus" type="boolean" onChange="updateFocus" />
    <field id="gridHasFocus" type="boolean" onChange="updateFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ChannelItem.brs" />
  <children>
    <Rectangle translation="[0,0]" width="260" height="146" color="0x1B1230FF" />
