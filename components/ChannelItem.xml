    <Label id="code" translation="[0,12]" width="260" height="76" horizAlign="center" vertAlign="center" color="0xA66BFFFF" font="font:LargeBoldSystemFont" />
    <Label id="name" translation="[10,92]" width="240" height="46" horizAlign="center" vertAlign="center" color="0xF4F0FAFF" font="font:SmallSystemFont" />
    <Group id="ring" visible="false">
      <Rectangle translation="[0,0]" width="260" height="5" color="0xA66BFFFF" />
      <Rectangle translation="[0,141]" width="260" height="5" color="0xA66BFFFF" />
      <Rectangle translation="[0,0]" width="5" height="146" color="0xA66BFFFF" />
      <Rectangle translation="[255,0]" width="5" height="146" color="0xA66BFFFF" />
    </Group>
  </children>
</component>
