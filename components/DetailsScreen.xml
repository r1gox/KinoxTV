<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailsScreen" extends="Group">
  <interface>
    <field id="apiKey" type="string" />
    <field id="content" type="node" onChange="onContent" />
    <field id="isFav" type="boolean" onChange="onFavChanged" />
    <field id="action" type="string" alwaysNotify="true" />
    <field id="playStatus" type="string" onChange="onPlayStatus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/DetailsScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0A0611FF" />
    <Poster id="bd" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.4" />
    <Rectangle width="1920" height="1080" color="0x0A06119C" />
    <Poster uri="pkg:/images/shade_left.png" width="1920" height="1080" />
    <Poster uri="pkg:/images/shade_bottom.png" width="1920" height="1080" />
    <Poster id="poster" translation="[96,170]" width="360" height="540" loadDisplayMode="scaleToZoom" />
    <Label id="title" translation="[520,170]" width="1300" font="font:LargeBoldSystemFont" color="0xF4F0FAFF" />
    <Label id="meta" translation="[520,250]" width="1300" font="font:MediumBoldSystemFont" color="0xCDB0FFFF" />
    <Label id="genres" translation="[520,305]" width="1300" font="font:MediumSystemFont" color="0xDDD6EEFF" />
    <Label id="ov" translation="[520,360]" width="1100" height="230" wrap="true" lineSpacing="8" font="font:MediumSystemFont" color="0xE4DDF2FF" />
    <Label id="prov" translation="[520,620]" width="1300" font="font:MediumSystemFont" color="0xFFD166FF" />
    <ButtonGroup id="btns" translation="[520,690]" layoutDirection="horiz" horizAlignment="left" minWidth="260" maxWidth="420" />
    <!-- Estado de carga del reproductor (dentro del detalle) -->
    <Rectangle id="playStatusBg" translation="[460,480]" width="1000" height="90" color="0x0A0611EE" visible="false" />
    <Label id="playStatusLbl" translation="[460,480]" width="1000" height="90" horizAlign="center" vertAlign="center" wrap="true" font="font:MediumBoldSystemFont" color="0xF4F0FAFF" visible="false" />
  </children>
</component>
